<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Stock Picking Form View - Add Delivery Notes after Origin -->
        <record id="view_picking_form_delivery_notes" model="ir.ui.view">
            <field name="name">stock.picking.form.delivery.notes</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='origin']" position="after">
                    <field name="delivery_notes" readonly="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
