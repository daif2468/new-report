<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Shared A4 paperformat used by the report actions.
             NOTE: in the original file this record was declared TWICE with the
             same id (once with margin_left/right = 2, once with margin_left/right = 0).
             Since both had the same id, Odoo would just overwrite it with whichever
             loads last. Kept the "0/0" margins version here (from the invoice report)
             — change if you actually wanted the 2/2 version. -->
        <record id="paperformat_a4_report" model="report.paperformat">
            <field name="name">A4 Report</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">7</field>
            <field name="margin_bottom">25</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">52</field>
            <field name="dpi">90</field>
        </record>

    </data>
</odoo>
